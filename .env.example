GEMINI_API_KEY=your_gemini_key_here
OPENWEATHER_API_KEY=your_openweathermap_key_here

# Django core settings (required for app to start)
DJANGO_SECRET_KEY=your-secret-key-here-run-python-django-secret-key-generator
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Optional: Initial admin setup credentials (used by setup_admin.py if set)
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=your_secure_password_here
# DJANGO_SUPERUSER_EMAIL=admin@example.com